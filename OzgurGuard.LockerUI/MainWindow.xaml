<Window x:Class="OzgurGuard.LockerUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ÖzgürGuard - Güvenlik Kilit Ekranı"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#0B0F19"
        FontFamily="Segoe UI"
        Foreground="#F8FAFC">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBg" Color="#111827"/>
        <SolidColorBrush x:Key="BorderNormal" Color="#334155"/>
        <SolidColorBrush x:Key="BorderError" Color="#EF4444"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#2563EB"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextError" Color="#FCA5A5"/>
        <SolidColorBrush x:Key="TextSuccess" Color="#86EFAC"/>
    </Window.Resources>

    <Grid>
        <!-- Deep Space Background Gradient -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#070A12" Offset="0.0"/>
                <GradientStop Color="#0B0F19" Offset="0.5"/>
                <GradientStop Color="#0F172A" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Ambient Glow Circles -->
        <Canvas>
            <Ellipse Width="600" Height="600" Canvas.Left="-100" Canvas.Top="-150" Opacity="0.12">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2563EB" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="650" Height="650" Canvas.Right="-150" Canvas.Bottom="-150" Opacity="0.08">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#06B6D4" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- Central Glassmorphism Security Card -->
        <Border x:Name="CardBorder"
                Width="520"
                Background="#E6111827"
                BorderBrush="{StaticResource BorderNormal}"
                BorderThickness="1"
                CornerRadius="20"
                Padding="40,36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTranslate"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="45" ShadowDepth="0" Opacity="0.65" Color="#000000"/>
            </Border.Effect>

            <StackPanel>
                <!-- Shield Icon with Glow -->
                <Grid Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Ellipse Fill="#1E293B" Stroke="#3B82F6" StrokeThickness="1.5"/>
                    <Path Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"
                          Fill="#60A5FA"
                          Width="28"
                          Height="28"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Grid>

                <!-- Company & Title Header -->
                <TextBlock Text="ÖZGÜR ZAMAN KONTROL SİSTEMLERİ"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           TextAlignment="Center"/>

                <TextBlock Text="Sunucu Erişim Güvenlik Katmanı | Yetkisiz Girişler Kayıt Altındadır"
                           Margin="0,8,0,0"
                           FontSize="12"
                           Foreground="{StaticResource TextMuted}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>

                <!-- Status Feedback Label -->
                <TextBlock x:Name="StatusText"
                           Margin="0,24,0,0"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{StaticResource TextMuted}"
                           TextAlignment="Center"
                           Text="Oturum doğrulaması bekleniyor."/>

                <!-- Password Input Box -->
                <PasswordBox x:Name="PasswordInput"
                             Margin="0,18,0,0"
                             Height="44"
                             Padding="12,10"
                             FontSize="16"
                             Background="#0A0F1D"
                             BorderBrush="{StaticResource BorderNormal}"
                             BorderThickness="1"
                             Foreground="#F8FAFC"
                             KeyDown="PasswordInput_KeyDown"/>

                <!-- Verify Button -->
                <Button x:Name="VerifyButton"
                        Margin="0,14,0,0"
                        Height="44"
                        Content="GİRİŞİ DOĞRULA"
                        FontWeight="Bold"
                        FontSize="13"
                        IsDefault="True"
                        Background="{StaticResource AccentBlue}"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="VerifyButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Timer & Remaining Attempts Info -->
                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CountdownText"
                               Text="Kalan süre: 45 sn"
                               FontSize="12"
                               Foreground="{StaticResource TextMuted}"/>
                    <TextBlock x:Name="AttemptsText"
                               Grid.Column="1"
                               Text="Kalan deneme: 3/3"
                               FontSize="12"
                               Foreground="{StaticResource TextMuted}"/>
                </Grid>

                <!-- Smooth Progress Bar -->
                <ProgressBar x:Name="CountdownBar"
                             Margin="0,8,0,0"
                             Height="5"
                             Minimum="0"
                             Maximum="45"
                             Value="45"
                             Foreground="{StaticResource AccentBlue}"
                             Background="#1E293B"
                             BorderThickness="0"/>

                <!-- System Info Footer -->
                <Border Margin="0,26,0,0" BorderBrush="{StaticResource BorderNormal}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="MachineText" Text="Sunucu: —" FontSize="11" Foreground="{StaticResource TextMuted}" FontFamily="Consolas"/>
                            <TextBlock x:Name="UserText" Margin="0,4,0,0" Text="Kullanıcı: —" FontSize="11" Foreground="{StaticResource TextMuted}" FontFamily="Consolas"/>
                            <TextBlock x:Name="ClockText" Margin="0,4,0,0" Text="—" FontSize="11" Foreground="{StaticResource TextMuted}" FontFamily="Consolas"/>
                        </StackPanel>

                        <!-- Safe Mode / Development Exit Button -->
                        <Button x:Name="TestExitButton"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Padding="10,6"
                                Content="Test Çıkışı (Geliştirici Modu)"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Background="#334155"
                                Foreground="#F59E0B"
                                BorderThickness="0"
                                Cursor="Hand"
                                Visibility="Collapsed"
                                Click="TestExitButton_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
