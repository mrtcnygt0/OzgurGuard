<Window x:Class="OzgurAuth.VerifierUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Özgür Zaman Kontrol Sistemleri"
        Width="480"
        Height="640"
        MinWidth="420"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#0F172A"
        FontFamily="Segoe UI"
        Foreground="#F8FAFC">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#111827"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="LineBrush" Color="#334155"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>
    </Window.Resources>

    <Grid Margin="28">
        <Border x:Name="CardBorder"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="32"
                VerticalAlignment="Center">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTranslate"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.45" Color="#000000"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="ÖZGÜR ZAMAN KONTROL SİSTEMLERİ"
                           FontSize="20"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <TextBlock Text="RDP Yönetici Oturum Doğrulaması"
                           Margin="0,8,0,0"
                           FontSize="13"
                           Foreground="{StaticResource MutedBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>

                <TextBlock x:Name="StatusText"
                           Margin="0,22,0,0"
                           FontSize="13"
                           Foreground="{StaticResource MutedBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Text="Oturum doğrulaması bekleniyor."/>

                <PasswordBox x:Name="PasswordInput"
                             Margin="0,18,0,0"
                             Height="40"
                             Padding="10,8"
                             FontSize="16"
                             Background="#0B1220"
                             BorderBrush="{StaticResource LineBrush}"
                             Foreground="#F8FAFC"
                             IsEnabled="False"/>

                <Button x:Name="VerifyButton"
                        Margin="0,14,0,0"
                        Height="42"
                        Content="OTURUMU DOĞRULA"
                        FontWeight="SemiBold"
                        IsDefault="True"
                        IsEnabled="False"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="VerifyButton_Click"/>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CountdownText"
                               Text="Kalan süre: —"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="AttemptsText"
                               Grid.Column="1"
                               Text="Kalan deneme: —"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"/>
                </Grid>

                <ProgressBar x:Name="CountdownBar"
                             Margin="0,8,0,0"
                             Height="6"
                             Minimum="0"
                             Maximum="45"
                             Value="45"
                             Foreground="{StaticResource AccentBrush}"
                             Background="#1E293B"
                             BorderThickness="0"/>

                <Border Margin="0,24,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                    <StackPanel>
                        <TextBlock x:Name="MachineText" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="UserText" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="ClockText" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
